{
  "version": 1,
  "checks": [
    {
      "name": "default",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": true,
      "features": []
    },
    {
      "name": "no-default-features",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": false,
      "features": []
    },
    {
      "name": "sync-only",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": false,
      "features": [
        "sync"
      ]
    },
    {
      "name": "async-only",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": false,
      "features": [
        "async"
      ]
    },
    {
      "name": "sync-discovery",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": false,
      "features": [
        "sync",
        "discovery"
      ]
    },
    {
      "name": "async-discovery",
      "commands": [
        "check",
        "test",
        "doc"
      ],
      "defaultFeatures": false,
      "features": [
        "async",
        "discovery"
      ]
    },
    {
      "name": "sync-conformance",
      "commands": [
        "test"
      ],
      "defaultFeatures": false,
      "features": [
        "sync",
        "conformance"
      ],
      "dependency": {
        "name": "redis",
        "resolution": "precise",
        "version": "0.32.7"
      }
    },
    {
      "name": "async-conformance",
      "commands": [
        "test"
      ],
      "defaultFeatures": false,
      "features": [
        "async",
        "conformance"
      ],
      "dependency": {
        "name": "redis",
        "resolution": "precise",
        "version": "0.32.7"
      }
    },
    {
      "name": "all-features",
      "commands": [
        "test"
      ],
      "allFeatures": true,
      "dependency": {
        "name": "redis",
        "resolution": "precise",
        "version": "0.32.7"
      }
    }
  ]
}
